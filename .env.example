# Copy to .env and set a new secret for this Django project.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset for local SQLite, or use a separate Supabase Postgres project.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional Supabase Storage; create a public bucket before using this.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-key
# SUPABASE_STORAGE_BUCKET=store-media
# Scheduled review emails (run: python manage.py send_review_requests)
# SITE_URL=https://your-django-domain.example
# eSewa ePay UAT only. Set the published UAT key from the official ePay docs
# in your private .env to enable the option; never commit it.
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=your-uat-secret-key
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=Store <shop@example.com>
